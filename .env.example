# Copy to .env and fill in. Never commit real values.

# Database (Supabase Postgres). Pooled URL for the app, direct URL for Prisma CLI.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&schema=app"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=app"
DB_SCHEMA="app"
# Optional: PEM CA certificate for strict TLS to the database
DATABASE_CA_CERT=""

# Admin auth — long random string (e.g. `openssl rand -base64 48`)
AUTH_SECRET=""
# Seeded admin accounts (used by `npm run db:seed`)
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD=""
SALES_EMAIL="sales@example.com"
SALES_PASSWORD=""
# Admin dashboard time zone, minutes east of UTC (300 = Pakistan)
ADMIN_TZ_OFFSET_MIN="300"

# Public site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# "true" only on the final domain — otherwise robots.txt blocks indexing
SITE_INDEXABLE="false"

# AI (all optional — without keys the deterministic engine answers).
# Tried in this order: Cerebras -> Groq -> Gemini Flash-Lite -> Gemini Flash -> AI Gateway.
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="gpt-oss-120b"
GOOGLE_GENERATIVE_AI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GROQ_API_KEY=""
AI_GATEWAY_API_KEY=""

# Email (Resend). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM="Sales <sales@yourdomain.com>"
EMAIL_TO_INTERNAL="sales@yourdomain.com"
