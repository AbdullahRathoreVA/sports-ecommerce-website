// Gridline — data model
//
// Postgres on Supabase (free tier). Money is integer minor units (cents)
// everywhere: a float drift on a 2,000-piece order is an invoice dispute.
//
// Rows created by the demo seed carry `isDemo = true` so the admin can show a
// "demo data" badge and purge them in one click before go-live. Real traffic
// and real enquiries are never flagged.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs live in prisma.config.ts (CLI) and the pg driver
// adapter (runtime), not in the schema.
datasource db {
  provider = "postgresql"
}

// ============================================================================
// SETTINGS & CONTENT
// ============================================================================

/// Admin-editable site configuration, addressed by key ("site", "home", ...).
/// Each consumer validates its own shape with Zod and falls back to defaults.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  topic     String   @default("general")
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, position])
}

/// Only real, client-supplied testimonials belong here. None are seeded.
/// Client reviews. Added by the team, or submitted on the website / client portal (then `pending` until approved).
model Testimonial {
  id        String   @id @default(cuid())
  author    String
  role      String?
  company   String?
  country   String?
  quote     String   @db.Text
  /// 1–5 stars, when the reviewer gave a rating.
  rating    Int?
  /// Never shown publicly; lets the team thank or verify the reviewer.
  email     String?
  /// Optional photo (team in their kit, the product …) from our own uploads.
  photo     String?
  /// Product line the review is about, e.g. "Soccer uniforms".
  productLine String?
  /// "admin" | "website" | "portal"
  source    String   @default("admin")
  /// Matched to a real order (portal review, or confirmed by the team).
  verified  Boolean  @default(false)
  /// Submitted by a visitor and not yet looked at by the team.
  pending   Boolean  @default(false)
  featured  Boolean  @default(false)
  customerId String?
  published Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Only certificates the client can produce. None are seeded.
model Certification {
  id         String    @id @default(cuid())
  name       String
  issuer     String?
  reference  String?
  validUntil DateTime?
  fileUrl    String?
  published  Boolean   @default(false)
  position   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  body        String    @db.Text
  coverImage  String?
  coverAlt    String?
  topic       String    @default("guide")
  published   Boolean   @default(false)
  publishedAt DateTime?
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ============================================================================
// CATALOGUE
// ============================================================================

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  shortName   String?
  tagline     String?
  description String    @db.Text
  image       String?
  imageAlt    String?
  position    Int       @default(0)
  published   Boolean   @default(true)
  seoTitle    String?
  seoDesc     String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, position])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// How a product can be bought. B2B lines should not be forced through a
/// consumer checkout, and consumer lines should not be hidden behind a quote.
enum PurchaseMode {
  QUOTE // Bulk / OEM only — request a quote
  CART  // Buy as listed
  BOTH  // Buy a sample or small run, or quote for bulk
}

model Product {
  id          String        @id @default(cuid())
  slug        String        @unique
  sku         String        @unique
  name        String
  subtitle    String?
  summary     String        @db.Text
  description String        @db.Text
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  position    Int           @default(0)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  purchaseMode    PurchaseMode @default(QUOTE)
  currency        String       @default("USD")
  /// Unit price for CART/BOTH, or an indicative "from" price for QUOTE. Null = on request.
  priceCents      Int?
  salePriceCents  Int?
  /// Price per unit sample (BOTH lines). Null = no sample sales.
  samplePriceCents Int?
  /// Quantity breaks: [{ minQty, unitCents }], ascending.
  priceTiers      Json        @default("[]")
  moq             Int         @default(1)
  stock           Int?
  leadTimeMinDays Int?
  leadTimeMaxDays Int?

  /// [{ label, value }] rendered as a spec table.
  specs          Json     @default("[]")
  materials      String[] @default([])
  customizations String[] @default([])
  features       String[] @default([])
  sizes          String[] @default([])
  /// [{ name, hex }]
  colors         Json     @default("[]")
  tags           String[] @default([])
  /// Industries / use cases this product suits, used by the product finder.
  useCases       String[] @default([])

  images   ProductImage[]
  variants ProductVariant[]
  videoUrl String?
  specSheetUrl String?

  seoTitle String?
  seoDesc  String?

  /// True for seed/demo catalogue entries (placeholder imagery or specs).
  isDemo Boolean @default(false)

  orderItems OrderItem[]
  leads      Lead[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([status, featured, position])
  @@index([categoryId, status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  /// Required — empty alt text is an accessibility failure.
  alt       String
  width     Int?
  height    Int?
  position  Int     @default(0)
  /// "client" = supplied by the factory; "placeholder" = generated stand-in;
  /// "render" = 3D studio render; "retired" = kept but no longer shown.
  source    String  @default("client")

  @@index([productId, position])
}

model ProductVariant {
  id              String  @id @default(cuid())
  productId       String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String  @unique
  size            String  @default("")
  color           String  @default("")
  priceDeltaCents Int     @default(0)
  stock           Int?
  active          Boolean @default(true)

  @@unique([productId, size, color])
  @@index([productId])
}

// ============================================================================
// CUSTOMERS, ORDERS, LEADS
// ============================================================================

enum CustomerSource {
  ORDER
  QUOTE
  CONTACT
  AI_ASSISTANT
  DESIGN_STUDIO
  PORTAL
  MANUAL
  PROSPECT
}

/// Public visitors never have accounts. A customer record is created from an
/// order, a quote request, a contact message or an AI-assisted enquiry.
model Customer {
  id        String         @id @default(cuid())
  email     String         @unique
  name      String
  phone     String?
  company   String?
  country   String?
  source    CustomerSource @default(QUOTE)
  notes     String?        @db.Text
  isDemo    Boolean        @default(false)
  orders    Order[]
  leads     Lead[]
  invoices  Invoice[]

  /// Client portal. Null until the customer creates an account; bcrypt only.
  passwordHash    String?
  /// Past quotes and orders under this email stay hidden until the address is proven.
  emailVerifiedAt DateTime?
  portalSince     DateTime?
  /// Bumped on password change / sign-out-everywhere to revoke every session.
  tokenVersion    Int       @default(0)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  codes           CustomerCode[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([createdAt])
}

/// One-time 6-digit codes for email verification and password reset (stored as HMACs).
model CustomerCode {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// "verify" | "reset"
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, purpose, createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  MANUFACTURING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum ShippingStatus {
  NOT_SHIPPED
  PACKED
  IN_TRANSIT
  DELIVERED
  RETURNED
}

model Order {
  id          String @id @default(cuid())
  /// Human-facing, e.g. "GL-26-00042".
  orderNumber String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  status         OrderStatus    @default(PENDING)
  paymentStatus  PaymentStatus  @default(UNPAID)
  shippingStatus ShippingStatus @default(NOT_SHIPPED)
  paymentMethod  String

  /// Authoritative server-computed totals. The client's numbers are never stored.
  subtotalCents Int
  discountCents Int    @default(0)
  shippingCents Int    @default(0)
  totalCents    Int
  currency      String @default("USD")

  contactName  String
  contactEmail String
  contactPhone String?
  company      String?

  shipLine1   String
  shipLine2   String?
  shipCity    String
  shipRegion  String?
  shipPostal  String?
  shipCountry String

  customerNote   String? @db.Text
  internalNotes  String? @db.Text
  carrier        String?
  trackingNumber String?

  /// Dispute evidence: explicit acceptance of the terms at checkout.
  termsAcceptedAt DateTime?
  termsVersion    String?

  items       OrderItem[]
  events      OrderEvent[]
  attachments OrderAttachment[]
  emails      EmailLog[]
  invoices    Invoice[]

  /// First-party attribution, no PII.
  sessionId String?
  isDemo    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([customerId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Denormalised so an invoice never changes when a product is renamed.
  nameSnapshot  String
  skuSnapshot   String
  imageSnapshot String?
  size          String?
  color         String?
  isSample      Boolean @default(false)
  quantity      Int
  unitCents     Int
  totalCents    Int

  @@index([orderId])
  @@index([productId])
}

/// Packing / QC / dispatch photos — proof of condition at dispatch for
/// damage claims and chargeback disputes.
model OrderAttachment {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  mediaId    String
  /// "qc" | "packing" | "dispatch" | "document" | "other"
  kind       String   @default("qc")
  caption    String?
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([orderId])
}

/// Every email the site sends (or would send) — an auditable communication
/// trail for orders and leads, kept even when no email provider is configured.
model EmailLog {
  id          String   @id @default(cuid())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  leadId      String?
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  toAddress   String
  subject     String
  body        String   @db.Text
  /// "sent" | "failed" | "skipped" (no provider configured)
  status      String
  provider    String?
  providerId  String?
  error       String?
  kind        String
  createdAt   DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([leadId, createdAt])
  @@index([createdAt])
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "status" | "payment" | "shipping" | "note" | "created"
  kind       String
  fromValue  String?
  toValue    String?
  note       String?  @db.Text
  actorEmail String?
  createdAt  DateTime @default(now())

  @@index([orderId, createdAt])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  NEGOTIATING
  WON
  LOST
}

enum LeadSource {
  QUOTE_FORM
  PRODUCT_PAGE
  CONTACT_FORM
  AI_ASSISTANT
  DESIGN_STUDIO
  PRODUCT_FINDER
  /// Added by the team (WhatsApp, phone call, exhibition, referral …).
  MANUAL
  /// Saved from the admin lead finder (a real business found on OpenStreetMap / the web).
  LEAD_FINDER
  /// The website's "send me prices" offer.
  PRICE_OFFER
}

/// Every quote request, contact message and AI-captured enquiry is a lead.
model Lead {
  id         String     @id @default(cuid())
  /// Human-facing, e.g. "RFQ-26-00017".
  leadNumber String     @unique
  status     LeadStatus @default(NEW)
  source     LeadSource

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  name     String
  /// Optional: a lead added by hand or found by the lead finder may only have a phone or a website.
  email    String?
  phone    String?
  company  String?
  country  String?
  city     String?
  website  String?
  /// Lead finder / manual extras: { origin, osmId, kind, address, foundBy, query } — never shown publicly.
  meta     Json?
  /// "email" | "whatsapp" | "phone"
  preferredChannel String @default("email")

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String?
  category    String?
  quantity    Int?
  /// Structured requirement: { material, colors, branding, sizes, sizeBreakdown, decoration, notes }
  requirements Json    @default("{}")
  budget       String?
  targetDate   String?
  message      String? @db.Text

  /// Snapshot of a Design Studio design, if the lead came from there.
  design    Json?
  /// One-paragraph AI summary for the sales team (never shown to the customer).
  aiSummary String? @db.Text

  assignedToId String?
  assignedTo   AdminUser? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes        LeadNote[]

  sessionId String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([productId])
}

model LeadNote {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorEmail String
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([leadId, createdAt])
}

// ============================================================================
// ADMIN & AUDIT
// ============================================================================

enum AdminRole {
  OWNER  // Everything, including users
  ADMIN  // Everything except users
  SALES  // Orders, leads, customers, analytics
  EDITOR // Products and content
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  /// bcrypt hash. Plaintext never reaches this table.
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  /// Bumped on password change / revoke to kill every issued session at once.
  tokenVersion Int       @default(0)
  /// Database-backed lockout, so it holds across serverless instances.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?
  leads        Lead[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Append-only record of privileged actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  /// { before, after } for updates; arbitrary detail otherwise.
  diff       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

// ============================================================================
// FIRST-PARTY ANALYTICS
// ============================================================================
//
// Cookie-free. The browser keeps a random anonymous id in localStorage (no
// name, email or IP is ever attached to it); visitors who send Global Privacy
// Control or Do Not Track get a per-day hash instead, so they are counted but
// never recognised on a later day. IP addresses are used only to derive the
// country and city at the edge and are never stored.

model Visitor {
  id          String    @id
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  sessions    Int       @default(1)
  country     String?
  isDemo      Boolean   @default(false)
  sessionRows Session[]

  @@index([lastSeenAt])
}

model Session {
  id           String   @id
  visitorId    String
  visitor      Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  startedAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  landingPath  String
  lastPath     String
  pageViews    Int      @default(0)
  referrerHost String?
  /// "direct" | "organic" | "social" | "referral" | "paid" | "email" | "ai"
  channel      String   @default("direct")
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  device       String
  browser      String?
  os           String?
  country      String?
  city         String?
  isReturning  Boolean  @default(false)
  isBot        Boolean  @default(false)
  isDemo       Boolean  @default(false)
  events       Event[]

  @@index([startedAt])
  @@index([lastSeenAt])
  @@index([visitorId])
}

model Event {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  visitorId  String
  name       String
  path       String
  productId  String?
  category   String?
  label      String?
  value      Int?
  props      Json?
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([productId, name])
  @@index([createdAt])
  @@index([sessionId])
}

// ============================================================================
// MEDIA
// ============================================================================

/// Admin-uploaded images, stored in Postgres and served by /media/[id] with an
/// immutable cache header so the CDN — not the database — absorbs the traffic.
/// Keeps uploads free and inside one system for the demo; swap to object
/// storage (Supabase Storage / Cloudinary) by changing src/lib/media.ts only.
model MediaAsset {
  id         String   @id @default(cuid())
  sha256     String   @unique
  filename   String
  mimeType   String
  bytes      Bytes
  size       Int
  width      Int?
  height     Int?
  uploadedBy String?
  createdAt  DateTime @default(now())
}

// ============================================================================
// AI
// ============================================================================

model AiConversation {
  id        String   @id @default(cuid())
  /// "assistant" | "oem" | "admin"
  kind      String
  sessionId String?
  actorEmail String?
  messages  Json
  /// Which engine answered: "llm:<model>" or "grounded".
  engine    String
  leadId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, createdAt])
}

/// Invoices: issued to a customer (optionally for an order). Amounts are
/// stored, not recomputed, so a sent invoice never changes behind anyone's back.
model Invoice {
  id            String        @id @default(cuid())
  /// Human-facing, sequential per year: INV-2026-0001.
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  poNumber  String?
  issueDate DateTime  @default(now())
  dueDate   DateTime?
  currency  String    @default("USD")

  // Bill-to snapshot (kept as it was when the invoice was issued).
  billName    String
  billCompany String?
  billEmail   String
  billPhone   String?
  billAddress String? @db.Text

  shipVia      String?
  deliveryTime String?

  subtotalCents Int
  discountCents Int @default(0)
  shippingCents Int @default(0)
  /// Tax rate in basis points (1700 = 17%).
  taxBasisPoints Int @default(0)
  taxCents       Int @default(0)
  totalCents     Int
  paidCents      Int @default(0)

  paymentTerms String  @db.Text
  notes        String? @db.Text

  sentAt    DateTime?
  paidAt    DateTime?
  voidedAt  DateTime?
  createdBy String?
  isDemo    Boolean   @default(false)

  items    InvoiceItem[]
  payments InvoicePayment[]
  emails   EmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([orderId])
  @@index([status, issueDate])
  @@index([issueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  description String
  details     String?
  quantity    Int
  unitCents   Int
  totalCents  Int

  @@index([invoiceId])
}

model InvoicePayment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int
  method      String
  reference   String?
  receivedAt  DateTime
  note        String?
  recordedBy  String?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}
